{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "start": "node ./dist/client/server/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "run-p test:unit test:e2e && echo \"🟦 angular tests passed 🎉\"",
    "test:unit": "yarn vitest run --reporter=default --coverage",
    "test:e2e": "yarn playwright test --reporter=list,html",
    "install_pkg": "yarn install && yarn playwright install",
    "dev": "ng serve",
    "check": "ng lint && echo \"🟦 angular check passed 🎉\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.3",
    "@motionone/dom": "^10.18.0",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "@ngrx/store-devtools": "^20.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.3.0",
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/jsdom": "^27",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^3.2.4",
    "angular-eslint": "20.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "jasmine-core": "~5.9.0",
    "jsdom": "^27.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.40.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
